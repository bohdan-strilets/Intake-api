  "info": {
    "title": "Intake API",
    "description": "API contract for Intake",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ],
            "example": "male"
          },
          "dateOfBirth": {
            "format": "date-time",
            "type": "string",
            "example": "1990-01-01"
          },
          "height": {
            "type": "number",
            "example": 175,
            "minimum": 120,
            "maximum": 230
          },
          "weight": {
            "type": "number",
            "example": 70,
            "minimum": 30,
            "maximum": 300
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ],
            "example": "lose"
          },
          "activityLevel": {
            "type": "number",
            "enum": [
              1.2,
              1.375,
              1.55,
              1.725,
              1.9
            ],
            "example": 1.55
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "sex",
          "dateOfBirth",
          "height",
          "weight",
          "goal",
          "activityLevel"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "EMAIL_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "INVALID_CURRENT_PASSWORD",
              "NEW_PASSWORD_MUST_BE_DIFFERENT",
              "UNAUTHORIZED",
              "INVALID_SESSION",
              "VALIDATION_ERROR",
              "USER_NOT_FOUND",
              "ACCOUNT_DELETED",
              "FOOD_NOT_FOUND",
              "FOOD_BAD_REQUEST",
              "AI_PARSE_FAILED",
              "DAY_NOT_FOUND",
              "SERVER_ERROR"
            ],
            "example": "VALIDATION_ERROR",
            "description": "Machine-readable error code"
          }
        },
        "required": [
          "code"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "MetabolismDto": {
        "type": "object",
        "properties": {
          "bmr": {
            "type": "number",
            "example": 1500
          },
          "recommendedCalories": {
            "type": "number",
            "example": 2000
          }
        },
        "required": [
          "bmr",
          "recommendedCalories"
        ]
      },
      "UserSettingsDto": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ],
            "example": "light"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "pl",
              "uk"
            ],
            "example": "en"
          },
          "sound": {
            "type": "boolean",
            "example": true
          },
          "volume": {
            "type": "number",
