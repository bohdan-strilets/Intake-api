  "info": {
    "title": "Intake API",
    "description": "API contract for Intake",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ],
            "example": "male"
          },
          "age": {
            "type": "number",
            "example": 30,
            "minimum": 10,
            "maximum": 100
          },
          "height": {
            "type": "number",
            "example": 175,
            "minimum": 120,
            "maximum": 230
          },
          "weight": {
            "type": "number",
            "example": 70,
            "minimum": 30,
            "maximum": 300
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ],
            "example": "lose"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "sex",
          "age",
          "height",
          "weight",
          "goal"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "65f0c1b2a3e4f56789012345"
          },
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ],
            "example": "male"
          },
          "age": {
            "type": "number",
            "example": 30
          },
          "height": {
            "type": "number",
            "example": 175
          },
          "weight": {
            "type": "number",
            "example": 70
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ],
            "example": "lose"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "sex",
          "age",
          "height",
          "weight",
          "goal"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponseDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "EMAIL_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "UNAUTHORIZED",
              "INVALID_SESSION",
              "VALIDATION_ERROR",
              "USER_NOT_FOUND",
              "FOOD_NOT_FOUND",
              "AI_PARSE_FAILED",
              "SERVER_ERROR"
            ],
            "example": "VALIDATION_ERROR",
            "description": "Machine-readable error code"
          }
        },
        "required": [
          "code"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateEmailDto": {
        "type": "object",
        "properties": {}
      },
      "UpdatePasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateFoodDto": {
        "type": "object",
        "properties": {}
      },
      "CreateFoodFromAiDto": {
        "type": "object",
        "properties": {}
      },
      "ParseFoodDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Chicken sandwich with lettuce and tomato",
            "minLength": 3,
            "maxLength": 1000,
            "description": "Free-form text description of eaten food"
          }
        },
        "required": [
          "text"
        ]
      },
      "ParsedFoodItemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Chicken sandwich"
          },
          "weight": {
            "type": "number",
            "example": 200
          },
          "calories": {
            "type": "number",
            "example": 330
          },
          "protein": {
            "type": "number",
            "example": 46
          },
          "fat": {
            "type": "number",
            "example": 6
          },
          "carbs": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "title",
          "weight",
          "calories",
          "protein",
          "fat",
          "carbs"
        ]
      },
      "ParseFoodResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParsedFoodItemDto"
            }
          },
          "assumptions": {
            "type": "string",
            "example": "Assumed standard chicken breast, cooked"
          }
        },
        "required": [
          "items"
        ]
      }
    }
  }
}