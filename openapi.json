  "info": {
    "title": "Intake API",
    "description": "API contract for Intake",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ],
            "example": "male"
          },
          "age": {
            "type": "number",
            "example": 30,
            "minimum": 10,
            "maximum": 100
          },
          "height": {
            "type": "number",
            "example": 175,
            "minimum": 120,
            "maximum": 230
          },
          "weight": {
            "type": "number",
            "example": 70,
            "minimum": 30,
            "maximum": 300
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ],
            "example": "lose"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "sex",
          "age",
          "height",
          "weight",
          "goal"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "EMAIL_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "UNAUTHORIZED",
              "INVALID_SESSION",
              "VALIDATION_ERROR",
              "USER_NOT_FOUND",
              "FOOD_NOT_FOUND",
              "AI_PARSE_FAILED",
              "SERVER_ERROR"
            ],
            "example": "VALIDATION_ERROR",
            "description": "Machine-readable error code"
          }
        },
        "required": [
          "code"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "65f0c1b2a3e4f56789012345"
          },
          "email": {
            "type": "string",
            "example": "user@email.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ],
            "example": "male"
          },
          "age": {
            "type": "number",
            "example": 30
          },
          "height": {
            "type": "number",
            "example": 175
          },
          "weight": {
            "type": "number",
            "example": 70
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ],
            "example": "lose"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "sex",
          "age",
          "height",
          "weight",
          "goal"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "age": {
            "type": "number",
            "minimum": 10,
            "maximum": 100
          },
          "height": {
            "type": "number",
            "minimum": 120,
            "maximum": 230
          },
          "weight": {
            "type": "number",
            "minimum": 30,
            "maximum": 300
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ]
          }
        }
      },
      "UpdateEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@email.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdatePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          },
          "newPassword": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "maxLength": 80
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "DayTotalsDto": {
        "type": "object",
        "properties": {
          "calories": {
            "type": "number",
            "example": 2000,
            "description": "Total calories"
          },
          "protein": {
            "type": "number",
            "example": 150,
            "description": "Total protein in grams"
          },
          "fat": {
            "type": "number",
            "example": 70,
            "description": "Total fat in grams"
          },
          "carbs": {
            "type": "number",
            "example": 250,
            "description": "Total carbohydrates in grams"
          }
        },
        "required": [
          "calories",
          "protein",
          "fat",
          "carbs"
        ]
      },
      "CalendarDayDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-02-01"
          },
          "totals": {
            "$ref": "#/components/schemas/DayTotalsDto"
          }
        },
        "required": [
          "date",
          "totals"
        ]
      },
      "DayResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "example": "2026-02-01"
          },
          "totals": {
            "$ref": "#/components/schemas/DayTotalsDto"
          },
          "weight": {
            "type": "number",
            "example": 82.5
          }
        },
        "required": [
          "id",
          "date",
          "totals"
        ]
      },
      "FoodResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "calories": {
            "type": "number"
          },
          "protein": {
            "type": "number"
          },
          "fat": {
            "type": "number"
          },
          "carbs": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "title",
          "weight",
          "calories",
          "protein",
          "fat",
          "carbs"
        ]
      },
      "DayDetailsResponseDto": {
        "type": "object",
        "properties": {
          "day": {
            "$ref": "#/components/schemas/DayResponseDto"
          },
          "food": {
