<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>{{> styles}}</style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      {{> email-header}}
      <h1>Email address changed</h1>
      <p class="lead">Your account email was changed to <strong>{{newEmail}}</strong>.</p>
      <div class="alert alert-info">Please check your new inbox and verify the new email address to continue using the app.</div>
      <p>If you did not make this change, please contact support immediately.</p>
      {{> email-footer}}
    </div>
  </div>
</body>
</html>
