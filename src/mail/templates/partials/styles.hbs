/* Shared email styles – aligned with frontend light theme (Food Diary) */
/* Colors: bg #EEF1F4, surface #FFFFFF, text #111315, muted #8A9098, primary #39C98A, link #3B82F6, border #DDE2E8, error #D64545, success bg #DFF6ED */

body {
  margin: 0;
  padding: 0;
  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 16px;
  line-height: 1.7;
  color: #111315;
  background-color: #EEF1F4;
}

.wrapper {
  max-width: 560px;
  margin: 0 auto;
  padding: 32px 24px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 14px;
  padding: 32px;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12);
  border: 1px solid #DDE2E8;
}

.email-header {
  text-align: center;
  padding-bottom: 24px;
  margin-bottom: 24px;
  border-bottom: 1px solid #DDE2E8;
}

.email-brand {
  font-size: 20px;
  font-weight: 700;
  color: #111315;
  letter-spacing: -0.02em;
}

.email-footer {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid #DDE2E8;
  text-align: center;
}

.email-footer-text {
  font-size: 13px;
  color: #8A9098;
  margin: 0;
}

h1 {
  margin: 0 0 8px;
  font-size: 22px;
  font-weight: 700;
  color: #111315;
  line-height: 1.3;
}

.lead {
  font-size: 16px;
  color: #3E434A;
  margin: 0 0 20px;
  line-height: 1.6;
}

p {
  margin: 0 0 16px;
  color: #3E434A;
  font-size: 15px;
  line-height: 1.6;
}

p:last-child {
  margin-bottom: 0;
}

p.muted {
  color: #8A9098;
  font-size: 14px;
}

.alert {
  padding: 14px 18px;
  border-radius: 10px;
  margin: 20px 0;
  font-size: 14px;
  line-height: 1.5;
}

.alert-success {
  background-color: #DFF6ED;
  color: #111315;
  border: 1px solid #C9EEDF;
}

.alert-warning {
  background-color: #FFE2B0;
  color: #111315;
  border: 1px solid #E8D4A8;
}

.alert-info {
  background-color: #E2E6EB;
  color: #111315;
  border: 1px solid #DDE2E8;
}

a.button {
  display: inline-block;
  padding: 14px 32px;
  font-weight: 500;
  font-size: 16px;
  color: #04130C;
  background: linear-gradient(180deg, #39C98A 0%, #2EB87A 100%);
  border-radius: 10px;
  text-decoration: none;
  margin: 8px 0 20px 0;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
}

a.button:hover {
  background: #2FBF78;
}

a.link {
  color: #3B82F6;
  text-decoration: none;
  word-break: break-all;
}

a.link:hover {
  text-decoration: underline;
}

hr {
  border: none;
  border-top: 1px solid #DDE2E8;
  margin: 24px 0;
}

strong {
  color: #111315;
  font-weight: 600;
}

.container {
  max-width: 560px;
  margin: 0 auto;
  padding: 32px 24px;
}

.spacer-sm { height: 12px; }
.spacer-md { height: 20px; }
.spacer-lg { height: 28px; }
