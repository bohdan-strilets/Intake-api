body {
  margin: 0;
  padding: 0;
  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 16px;
  line-height: 1.7;
  color: #111315;
  background-color: #EEF1F4;
}
.container {
  max-width: 560px;
  margin: 0 auto;
  padding: 32px 24px;
}
.card {
  background-color: #FFFFFF;
  border-radius: 10px;
  padding: 32px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}
h1 {
  margin: 0 0 16px;
  font-size: 22px;
  font-weight: 700;
  color: #111315;
}
p {
  margin: 0 0 16px;
  color: #3E434A;
}
p.muted {
  color: #8A9098;
  font-size: 14px;
}
a.button {
  display: inline-block;
  padding: 12px 32px;
  font-weight: 500;
  font-size: 16px;
  color: #04130C;
  background-color: #39C98A;
  border-radius: 10px;
  text-decoration: none;
}
a.button:hover {
  background-color: #2FBF78;
}
a.link {
  color: #3B82F6;
  text-decoration: none;
}
hr {
  border: none;
  border-top: 1px solid #DDE2E8;
  margin: 24px 0;
}
